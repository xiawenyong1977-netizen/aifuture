<?xml version="1.0" encoding="utf-8"?>
<!-- 简化的通知布局，只使用 RemoteViews 支持的基本视图 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 左侧：状态图标容器 -->
    <LinearLayout
        android:id="@+id/status_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#4f46e5"
        android:layout_marginEnd="12dp">

        <!-- 简化的波形显示 - 使用 ImageView 替代 View，因为 RemoteViews 不支持纯 View -->
        <ImageView
            android:id="@+id/wave1"
            android:layout_width="2dp"
            android:layout_height="8dp"
            android:background="#a5b4fc"
            android:layout_marginEnd="1dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/wave2"
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#a5b4fc"
            android:layout_marginEnd="1dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/wave3"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:background="#a5b4fc"
            android:layout_marginEnd="1dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/wave4"
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#a5b4fc"
            android:layout_marginEnd="1dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/wave5"
            android:layout_width="2dp"
            android:layout_height="8dp"
            android:background="#a5b4fc"
            android:scaleType="fitXY" />
    </LinearLayout>

    <!-- 右侧：状态文本 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOREGROUND AUDIT ACTIVE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1e293b"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- 状态指示点 - 使用 ImageView 替代 View -->
            <ImageView
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#10b981"
                android:layout_marginEnd="6dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="监测中（麦克风可用）"
                android:textSize="11sp"
                android:textColor="#64748b" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
